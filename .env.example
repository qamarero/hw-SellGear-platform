# =============================================================
# MainOperation Platform — Variables de entorno
# Copia este archivo como .env.local (Next.js) y .env (scripts)
# NUNCA subas .env / .env.local al repositorio
# =============================================================

# -----------------------------------------------
# SUPABASE
# -----------------------------------------------
# URL del proyecto (ej: https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Clave pública (anon key) — segura para el cliente
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Service role key — SOLO en servidor/edge functions, NUNCA en cliente
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Referencia del proyecto (usado por CLI y MCP)
SUPABASE_PROJECT_REF=<project-ref>

# Personal Access Token (para MCP y Supabase CLI)
SUPABASE_ACCESS_TOKEN=<personal-access-token>

# -----------------------------------------------
# INVENTARIO (proyecto Supabase secundario)
# -----------------------------------------------
# La app principal (Next.js) consume el inventario desde un proyecto
# Supabase distinto donde viven las tablas hw_staging.hw_inventory y
# hw_staging.hw_articles. Las dos envs siguientes apuntan a ese
# proyecto secundario. Solo server-side: nunca en el bundle del cliente.
#
# URL del proyecto de inventario (ej. olcxbtvjkjmofrbvzpat.supabase.co)
INVENTORY_SUPABASE_URL=https://<inventory-project-ref>.supabase.co

# Service role key del proyecto de inventario (Project Settings -> API).
# Bypassa RLS — la autorizacion (quien puede consultar) la hace la app
# en /inventory/page.tsx ANTES de llamar a este cliente.
INVENTORY_SUPABASE_SERVICE_KEY=<inventory-service-role-key>

# Si estas dos envs no estan configuradas, la pagina /inventory muestra
# un banner ambar de "no configurado" en vez de crashear.

# -----------------------------------------------
# TYPEFORM
# -----------------------------------------------
# Secret para validar la firma HMAC del webhook
TYPEFORM_WEBHOOK_SECRET=<typeform-webhook-secret>

# -----------------------------------------------
# SLACK
# -----------------------------------------------
# Incoming Webhook URL del canal de Hardware. Configurar en Vercel.
# Si no esta configurada, los avisos se silencian (la app sigue funcionando).
# Logica en apps/web/lib/slack.ts (no hay edge function, todo es server-side).
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/<T>/<B>/<token>

# Menciones fijas por categoria de compra (JSON, opcional).
# Formato: { "<purchase_type>": ["U0123","U0456"], "default": ["U0789"] }
# "default" aplica si la purchase_type no tiene match propio.
# Member ID de Slack: en el perfil del usuario -> mas (...) -> "Copiar member ID".
SLACK_CATEGORY_MENTIONS={"hardware_financiacion":["U0XXXX"],"default":["U0YYYY"]}

# User Group de Slack del equipo Hardware (opcional). Si esta configurado,
# los avisos de new_order y message_to_hardware mencionan al grupo (formato
# <!subteam^ID> en Slack — pinguea solo a los miembros del grupo, no a
# todo el canal). Sustituye al deshabilitado @here.
# Para obtener el ID: Slack web -> Settings -> Browse User Groups -> click
# en "hardware_cx" -> la URL contiene el ID (formato S0XXXXXXXXX).
SLACK_HARDWARE_USERGROUP_ID=S0XXXXXXXXX

# -----------------------------------------------
# APP
# -----------------------------------------------
# URL pública de la app (para enlaces en Slack/emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------
# TIPSA (Transporte — Dinapaq SOAP WS)
# -----------------------------------------------
# Entorno activo: "test" (wsval) o "prod" (ws).
# Usar "test" para desarrollo. "prod" solo cuando se acepte el go-live.
TIPSA_ENV=test

# Credenciales por entorno — solicitarlas a TIPSA, NUNCA subir al repo.
# IMPORTANTE: si el password contiene '#' (TIPSA suele usarlo) hay que ENTRECOMILLARLO.
# Sin comillas Next.js trata '#' como comentario y trunca el valor.
# Ejemplo correcto: TIPSA_TEST_PASSWORD="Ts#30#2%4"
TIPSA_TEST_AGENCY_CODE=000000
TIPSA_TEST_CLIENT_CODE=33333
TIPSA_TEST_PASSWORD="<solicitar-a-tipsa>"

TIPSA_PROD_AGENCY_CODE=041033
TIPSA_PROD_CLIENT_CODE=010
TIPSA_PROD_PASSWORD="<solicitar-a-tipsa>"

# Remitente fijo (QR Payments Qamarero)
TIPSA_SENDER_NAME=QR PAYMENTS Qamarero
TIPSA_SENDER_ADDRESS=P.º Alcalde Marqués del Contadero, s/n, Casco Antiguo
TIPSA_SENDER_CITY=Sevilla
TIPSA_SENDER_CP=41001
TIPSA_SENDER_PHONE=602687553

# Catálogo de servicios TIPSA disponible en el selector de la UI.
# Formato JSON: [{"code":"48","label":"24h estándar"}, ...]
# Se puede ajustar sin deploy (solo variable de entorno).
TIPSA_SERVICES_CATALOG=[{"code":"48","label":"24h estándar"},{"code":"10","label":"48h"},{"code":"52","label":"Sábado"},{"code":"40","label":"14h (next day)"},{"code":"01","label":"Económico"}]

# Secret que protege POST /api/cron/tipsa-refresh (sweep de estados TIPSA).
# Lo dispara pg_cron desde Supabase cada 30 min y manda este valor en la
# cabecera X-Cron-Secret.
#
# IMPORTANTE: la misma cadena tiene que estar en el Vault de Supabase como
# 'tipsa_cron_secret'. Si no coinciden, cada ejecucion responde 401:
#
#   SELECT vault.create_secret('<valor>', 'tipsa_cron_secret', 'X-Cron-Secret');
#
# Generar con: openssl rand -hex 32
TIPSA_CRON_SECRET=<openssl-rand-hex-32>

# Servicio TIPSA que propone el formulario «Programar recogida» (/recogidas).
# Pendiente de que TIPSA confirme cual corresponde a recogidas; 48 mientras.
TIPSA_PICKUP_SERVICE_CODE=48

# -----------------------------------------------
# HSM — recogidas pedidas desde los RMA
# -----------------------------------------------
# Contrato: docs/integrations/hsm/RECOGIDAS-CONTRATO.md
#
# Clave con la que HSM llama a /api/external/hsm/pickups (X-API-Key).
# En HSM es MAINOPS_API_KEY. No acepta QARVIS_API_KEY: este endpoint escribe.
# Generar con: openssl rand -hex 32
HSM_API_KEY=
# A donde avisamos a HSM de los cambios de estado (sin barra final) y con que
# clave. En HSM la clave es MAINOPS_WEBHOOK_KEY.
HSM_BASE_URL=
HSM_WEBHOOK_KEY=

# -----------------------------------------------
# HWTOOLBOX — API publica read-only de pedidos
# -----------------------------------------------
# Endpoint /api/external/hwtoolbox/orders consumido por HWToolbox (gestion
# de inventario, server-to-server). Solo expone pedidos en estados
# preparado/enviado/enviado_proveedor/completado/bloqueado.

# API key compartida con HWToolbox (header X-API-Key).
# Generar con: openssl rand -hex 32
HWTOOLBOX_API_KEY=<openssl-rand-hex-32>

# Origenes CORS permitidos (CSV). Vacio = solo server-to-server (sin browser).
# Ejemplo: "https://hwtoolbox.vercel.app,https://hwtoolbox-staging.vercel.app"
HWTOOLBOX_ORIGIN=

# -----------------------------------------------
# QARVIS — clave compartida de solo lectura (cerebro del ecosistema)
# -----------------------------------------------
# Clave dedicada a Qarvis. validateApiKey la acepta ADEMAS de la clave
# especifica de cada endpoint externo (MAIN_PORTAL_API_KEY, HWTOOLBOX_API_KEY),
# de forma retro-compatible: no altera las claves de los demas consumidores.
# Permite que Qarvis lea /api/external/metrics y /api/external/hwtoolbox/* con
# una sola clave. En Qarvis esta misma clave va como MAINOPS_API_KEY.
# Generar con: openssl rand -hex 32
QARVIS_API_KEY=<openssl-rand-hex-32>
